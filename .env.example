# ==============================================================================
# SUNU ARTISANAT — Configuration des Variables d'Environnement
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de données PostgreSQL (Supabase avec Transaction Pooling)
# ------------------------------------------------------------------------------
# DATABASE_URL: URL connectée au pooler Supabase (port 6543, mode transaction)
# Exemple: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"

# DIRECT_URL: Connexion directe pour les migrations Prisma (port 5432, session)
# Exemple: postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Authentification (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
# Clé secrète de signature des sessions (générée par: openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-here-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Supabase Client & Storage (Téléchargement sécurisé des photos d'ateliers)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 4. Service d'Emailing (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="SUNU ARTISANAT <contact@sunuartisanat.sn>"

# ------------------------------------------------------------------------------
# 5. Assistant IA (Groq en production / Ollama en local)
# ------------------------------------------------------------------------------
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.1-70b-versatile"
OLLAMA_BASE_URL="http://localhost:11434"

# ------------------------------------------------------------------------------
# 6. Agrégateur de Paiement Sénégalais (Mode Test / Simulation)
# ------------------------------------------------------------------------------
# Choix agrégateur (PayDunya, CinetPay, PayTech)
PAYMENT_AGGREGATOR="PAYTECH"
PAYTECH_API_KEY="your-paytech-api-key"
PAYTECH_API_SECRET="your-paytech-api-secret"
NEXT_PUBLIC_ENABLE_PAYMENT_SIMULATION="true"

# ------------------------------------------------------------------------------
# 7. WhatsApp Business API (Meta)
# ------------------------------------------------------------------------------
WHATSAPP_API_TOKEN="your-meta-whatsapp-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"

# ------------------------------------------------------------------------------
# 8. Paramètres de l'Application
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="SUNU ARTISANAT"
